{
  "description": "Capture Codex activity for the private daily ledger.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$HOME/.local/share/codex-insights/daily-ledger/capture_hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$HOME/.local/share/codex-insights/daily-ledger/capture_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
